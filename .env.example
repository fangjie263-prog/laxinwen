# Notion archive sync (never commit real credentials)
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=
NOTION_MAX_UPLOAD_MB=4.5
RESEARCHREADER_OUTPUT_ROOT=
RESEARCHREADER_BOOKS_ROOT=

# AI Research Archive（研究成果自动归档；默认 dry-run，不会移动任何文件）
# 把你与 Claude / ChatGPT / Gemini 对话后生成的最终成果（PDF / DOCX / HTML）
# 放进 RESEARCH_INBOX_DIR，然后运行：python -m news research-archive --apply
RESEARCH_INBOX_DIR=
RESEARCH_ARCHIVE_DIR=
RESEARCH_FAILED_DIR=
RESEARCH_DB=
RESEARCH_COMPANIES_FILE=
# 是否默认 dry-run（true 时只扫描、不移动、不上传；--apply 会覆盖为 false）
RESEARCH_DRY_RUN=true
# 单文件上限（MiB），与 Notion 保持一致，默认 4.5
RESEARCH_MAX_UPLOAD_MB=4.5
# 是否递归扫描 Inbox 子目录（默认 false）
RESEARCH_RECURSIVE=false
# 是否让现有 Laxinwen-Notion-Sync 计划任务顺带归档研究成果（默认关闭）
RESEARCH_ARCHIVE_IN_SCHEDULER=
